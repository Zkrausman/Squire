{
  "name": "squire-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:contracts": "node scripts/validate-contracts.mjs",
    "validate:contracts": "node scripts/validate-contracts.mjs",
    "validate:sandbox": "npm run build && node scripts/validate-sandbox-contracts.mjs",
    "verify:sandbox-release": "npm run build && node scripts/verify-sandbox-release.mjs",
    "validate:all": "npm run validate:contracts && npm run validate:sandbox",
    "test": "npm run build && node --test test/contracts.test.mjs dist/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "^5.9.2"
  }
}
