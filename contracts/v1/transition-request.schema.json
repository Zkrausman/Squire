{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:squire:contracts:v1:transition-request",
  "title": "Orchestrator transition request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "runId", "orchestratorSessionId", "fromState", "toState", "trigger", "currentHead", "phaseResult", "requestedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string", "pattern": "^transition_[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "runId": { "$ref": "urn:squire:contracts:v1:common#/$defs/runId" },
    "orchestratorSessionId": { "$ref": "urn:squire:contracts:v1:common#/$defs/sessionId" },
    "fromState": { "$ref": "urn:squire:contracts:v1:common#/$defs/activeState" },
    "toState": { "$ref": "urn:squire:contracts:v1:common#/$defs/state" },
    "trigger": { "enum": ["run_accepted", "preparation_complete", "phase_pass", "remediation_required", "publication_complete", "approval_observed", "system_failure", "operator_cancel", "retention_expired"] },
    "currentHead": { "$ref": "urn:squire:contracts:v1:common#/$defs/sha" },
    "phaseResult": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "urn:squire:contracts:v1:common#/$defs/contractReference" }
      ]
    },
    "requestedAt": { "$ref": "urn:squire:contracts:v1:common#/$defs/timestamp" }
  }
}
