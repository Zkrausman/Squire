{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:squire:contracts:v1:test-evidence",
  "title": "Test evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "sessionId", "testedHead", "status", "commands", "failures", "completedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "$ref": "urn:squire:contracts:v1:common#/$defs/runId" },
    "sessionId": { "$ref": "urn:squire:contracts:v1:common#/$defs/sessionId" },
    "testedHead": { "$ref": "urn:squire:contracts:v1:common#/$defs/sha" },
    "status": { "enum": ["pass", "remediation_required"] },
    "commands": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["commandId", "startedAt", "completedAt", "exitCode", "timedOut", "stdout", "stderr"],
        "properties": {
          "commandId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
          "startedAt": { "$ref": "urn:squire:contracts:v1:common#/$defs/timestamp" },
          "completedAt": { "$ref": "urn:squire:contracts:v1:common#/$defs/timestamp" },
          "exitCode": { "type": ["integer", "null"] },
          "timedOut": { "type": "boolean" },
          "stdout": { "$ref": "urn:squire:contracts:v1:common#/$defs/evidenceReference" },
          "stderr": { "$ref": "urn:squire:contracts:v1:common#/$defs/evidenceReference" }
        }
      }
    },
    "failures": { "type": "array", "items": { "$ref": "urn:squire:contracts:v1:common#/$defs/failure" }, "uniqueItems": true },
    "completedAt": { "$ref": "urn:squire:contracts:v1:common#/$defs/timestamp" }
  }
}
