{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:squire:contracts:v1:phase-result",
  "title": "Phase result envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "handoffId", "inputArtifact", "runId", "phase", "sessionId", "inputHead", "outputHead", "status", "artifacts", "evidence", "findings", "failures", "requestedTransition", "completedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "handoffId": { "$ref": "urn:squire:contracts:v1:common#/$defs/handoffId" },
    "inputArtifact": { "$ref": "urn:squire:contracts:v1:common#/$defs/contractReference" },
    "runId": { "$ref": "urn:squire:contracts:v1:common#/$defs/runId" },
    "phase": { "$ref": "urn:squire:contracts:v1:common#/$defs/phase" },
    "sessionId": { "$ref": "urn:squire:contracts:v1:common#/$defs/sessionId" },
    "inputHead": { "$ref": "urn:squire:contracts:v1:common#/$defs/sha" },
    "outputHead": { "$ref": "urn:squire:contracts:v1:common#/$defs/sha" },
    "status": { "enum": ["pass", "remediation_required", "failed"] },
    "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "urn:squire:contracts:v1:common#/$defs/artifactReference" }, "uniqueItems": true },
    "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "urn:squire:contracts:v1:common#/$defs/evidenceReference" }, "uniqueItems": true },
    "findings": { "type": "array", "items": { "$ref": "urn:squire:contracts:v1:common#/$defs/finding" }, "uniqueItems": true },
    "failures": { "type": "array", "items": { "$ref": "urn:squire:contracts:v1:common#/$defs/failure" }, "uniqueItems": true },
    "requestedTransition": { "$ref": "urn:squire:contracts:v1:common#/$defs/requestedTransition" },
    "completedAt": { "$ref": "urn:squire:contracts:v1:common#/$defs/timestamp" }
  }
}
