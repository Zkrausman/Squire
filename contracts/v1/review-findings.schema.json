{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:squire:contracts:v1:review-findings",
  "title": "Review findings v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "sessionId", "reviewedHead", "status", "summary", "findings", "completedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "$ref": "urn:squire:contracts:v1:common#/$defs/runId" },
    "sessionId": { "$ref": "urn:squire:contracts:v1:common#/$defs/sessionId" },
    "reviewedHead": { "$ref": "urn:squire:contracts:v1:common#/$defs/sha" },
    "status": { "enum": ["pass", "remediation_required"] },
    "summary": { "type": "string", "minLength": 1 },
    "findings": { "type": "array", "items": { "$ref": "urn:squire:contracts:v1:common#/$defs/finding" }, "uniqueItems": true },
    "completedAt": { "$ref": "urn:squire:contracts:v1:common#/$defs/timestamp" }
  }
}
