{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:squire:sandbox:v1:host-observer-request",
  "type":"object","additionalProperties":false,
  "required":["schemaVersion","kind","requestId","parentRequestId","runId","sandboxName","releaseId","platform","architecture","probe","phase","identity","paths","requestedAt"],
  "properties":{
    "schemaVersion":{"const":1},"kind":{"const":"squire-sandbox-host-observer-request"},
    "requestId":{"type":"string","format":"uuid"},"parentRequestId":{"type":"string","format":"uuid"},
    "runId":{"$ref":"urn:squire:contracts:v1:common#/$defs/runId"},"sandboxName":{"type":"string","pattern":"^squire-v1-[a-z2-7]{26}$"},"releaseId":{"type":"string","pattern":"^[a-z][a-z0-9._-]{0,127}$"},
    "platform":{"type":"string","pattern":"^[a-z][a-z0-9._-]{0,63}$"},"architecture":{"type":"string","pattern":"^[a-z][a-z0-9._-]{0,31}$"},
    "probe":{"enum":["sbx-identity","resource-enforcement","disk-quota","bridge-isolation","mount-isolation","principal-separation","rootless-docker","persistence","network-audit","credential-absence","process-topology","herdr-topology","exact-removal"]},
    "phase":{"enum":["created","running","restarted","removed"]},
    "identity":{"type":"object","additionalProperties":false,"required":["sandboxId","vmId","bootId","templateDigest"],"properties":{"sandboxId":{"type":"string","minLength":1,"maxLength":512},"vmId":{"type":"string","minLength":1,"maxLength":512},"bootId":{"type":"string","minLength":1,"maxLength":512},"templateDigest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}},
    "paths":{"type":"object","additionalProperties":false,"required":["stateRoot","bridgePath","evidenceRoot"],"properties":{"stateRoot":{"type":"string","minLength":2,"maxLength":4096},"bridgePath":{"type":"string","minLength":2,"maxLength":4096},"evidenceRoot":{"type":"string","minLength":2,"maxLength":4096}}},
    "requestedAt":{"type":"string","format":"date-time"}
  }
}
