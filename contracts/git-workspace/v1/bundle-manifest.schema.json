{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:squire:git-workspace:v1:bundle-manifest",
  "title": "Squire isolated Git bundle handoff v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "contract": { "type": "object", "additionalProperties": false, "required": ["path", "sha256", "schemaId"], "properties": { "path": { "type": "string", "pattern": "^artifacts/git/run_[A-Za-z0-9][A-Za-z0-9._-]{0,127}/(?:workspace-spec|workspace-manifest)\\.json$" }, "sha256": { "$ref": "#/$defs/sha256" }, "schemaId": { "enum": ["urn:squire:git-workspace:v1:workspace-spec", "urn:squire:git-workspace:v1:workspace-manifest"] } } },
    "ref": { "type": "object", "additionalProperties": false, "required": ["name", "oid"], "properties": { "name": { "type": "string", "pattern": "^refs/heads/.+" }, "oid": { "$ref": "#/$defs/sha" } } }
  },
  "required": ["schemaVersion", "kind", "spec", "workspaceManifest", "runId", "featureBranch", "baseSha", "headSha", "bundlePath", "byteLength", "sha256", "objectFormat", "prerequisites", "refs", "exportGeneration", "verifiedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "squire-git-bundle-manifest" },
    "spec": { "$ref": "#/$defs/contract" },
    "workspaceManifest": { "$ref": "#/$defs/contract" },
    "runId": { "type": "string", "pattern": "^run_[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "featureBranch": { "type": "string", "pattern": "^squire/[a-z][a-z0-9]+-[1-9][0-9]*-run_[A-Za-z0-9._-]+$", "maxLength": 1024 },
    "baseSha": { "$ref": "#/$defs/sha" },
    "headSha": { "$ref": "#/$defs/sha" },
    "bundlePath": { "type": "string", "pattern": "^artifacts/git/run_[A-Za-z0-9][A-Za-z0-9._-]{0,127}/(?:[0-9a-f]{40}|[0-9a-f]{64})\\.bundle$" },
    "byteLength": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
    "sha256": { "$ref": "#/$defs/sha256" },
    "objectFormat": { "enum": ["sha1", "sha256"] },
    "prerequisites": { "type": "array", "items": { "$ref": "#/$defs/sha" }, "uniqueItems": true },
    "refs": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/ref" } },
    "exportGeneration": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "verifiedAt": { "type": "string", "format": "date-time" }
  }
}
