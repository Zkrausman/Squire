{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "outputHead",
    "status",
    "summary",
    "details"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "outputHead": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findings",
        "commands"
      ],
      "properties": {
        "findings": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "commands": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "command",
              "exitCode",
              "summary"
            ],
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "exitCode": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          }
        }
      }
    }
  }
}
