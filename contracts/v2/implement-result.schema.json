{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "outputHead",
    "status",
    "summary",
    "details"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "outputHead": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changes",
        "projectWiki"
      ],
      "properties": {
        "changes": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "projectWiki": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "reason"
              ],
              "properties": {
                "status": {
                  "const": "not_required"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "paths",
                "summary"
              ],
              "properties": {
                "status": {
                  "const": "updated"
                },
                "paths": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1000,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^\\.llm-wiki/",
                    "maxLength": 512
                  }
                },
                "summary": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              }
            }
          ]
        }
      }
    }
  }
}
