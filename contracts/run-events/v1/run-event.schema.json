{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:squire:run-events:v1:run-event",
  "title": "Squire durable run event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "runId", "ticketId", "stateRevision", "timestamp", "type"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "runId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,127}$" },
    "ticketId": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+-[1-9][0-9]*$" },
    "stateRevision": { "type": "integer", "minimum": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "type": {
      "enum": [
        "run_reserved",
        "run_started",
        "phase_started",
        "phase_completed",
        "remediation_requested",
        "attention_required",
        "publication_started",
        "publication_completed",
        "ci_updated",
        "terminal_succeeded",
        "terminal_failed"
      ]
    },
    "phase": { "enum": ["plan", "implement", "review", "test", "retro"] },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "outcome": { "enum": ["passed", "failed", "remediation_required", "completed", "interrupted"] }
  }
}
