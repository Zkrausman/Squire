{
  "launchRetryPolicy": {
    "maxRetries": 1
  },
  "correctionPolicy": {
    "maxCorrections": 1,
    "maxRecordedCostUsd": "10"
  },
  "repository": {
    "slug": "OWNER/REPOSITORY",
    "path": "/absolute/path/to/your/repository/checkout",
    "sourceRef": "refs/remotes/origin/main",
    "baseBranch": "main"
  },
  "dataDirectory": "/absolute/path/to/your/squire-data",
  "linear": {
    "apiKeyEnv": "LINEAR_API_KEY"
  },
  "github": {
    "tokenCommand": [
      "squire-github-app-token"
    ]
  },
  "sandbox": {
    "template": "squire-personal-mvp:latest",
    "roleUser": "1000:1000",
    "piExecutable": "/usr/local/bin/pi",
    "piAgentDirectory": "/ticket/runtime/pi-agent",
    "piAuthFile": "pi-auth.json"
  },
  "modelPolicy": {
    "implement": {
      "provider": "openai-codex",
      "model": "gpt-6-luna",
      "thinking": "max"
    },
    "verify": {
      "provider": "openai-codex",
      "model": "gpt-6-sol",
      "thinking": "medium"
    }
  },
  "testCommands": [
    "npm test"
  ],
  "phaseTimeoutMs": 3600000
}
